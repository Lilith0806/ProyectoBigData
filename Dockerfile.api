FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/ /app/src/

ENV PYTHONPATH=/app
ENV PORT=5000

EXPOSE 5000

CMD ["python", "src/api/app.py"]
